# Local paths
SVIRO_ROOT=data/sviro
SVIRO_EXPORT=data/sviro_export
CABINSENSE_OUTPUT=outputs

# MLflow (leave empty to log to ./mlruns)
MLFLOW_TRACKING_URI=

# Optional COCO-pretrained YOLOX checkpoint (e.g. weights/yolox_m.pth)
YOLOX_WEIGHTS=

# AWS SageMaker
AWS_REGION=us-east-1
AWS_PROFILE=default
SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/YourSageMakerExecutionRole
SAGEMAKER_BUCKET=
